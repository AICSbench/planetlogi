# PlanetLogi Local Development Environment
APP_ENV=development
API_PORT=8080
WEB_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# PostgreSQL 16
DATABASE_URL=postgres://planetlogi:planetlogi_dev@localhost:5432/planetlogi?sslmode=disable

# Redis 7
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Security (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=planetlogi-dev-access-secret-change-me
JWT_REFRESH_SECRET=planetlogi-dev-refresh-secret-change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
OTP_DEV_ECHO=true

# Object Storage (MinIO locally / Cloudflare R2 in production)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=planetlogi-assets
S3_ACCESS_KEY=planetlogi_minio
S3_SECRET_KEY=planetlogi_minio_dev
ASSETS_PUBLIC_URL=http://localhost:9000/planetlogi-assets

# Feature Flags (Feature-First: Billing stays false throughout Phases 0-4)
BILLING_ENABLED=false

# Frontend Vite Env
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_NAME=PlanetLogi
